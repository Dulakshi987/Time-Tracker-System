{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.jsx", "src/**/*.js", "src/services/Issue_Pick_Portal/api.ts", "src/config/Permissions.js"]
}
